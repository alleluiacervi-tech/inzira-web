# Copy to .env.local. Nothing here is needed for local development.

# Postgres. Without it the app uses the embedded database in .data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/inzira
# Skip the automatic schema update on startup and run `npm run db:migrate` yourself.
# DB_AUTO_MIGRATE=0

# Demo mode for staging builds: shows sign-in codes on screen and simulates payments. Never on the live site.
# INZIRA_DEMO=1

# Keys sign-in codes to this server. Set a long random value on the live site (openssl rand -hex 32).
# AUTH_SECRET=

# SMS (sign-in codes and customer updates)
# SMS_PROVIDER=africastalking
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=

# Mobile money: "live" (MTN MoMo + Airtel Money) or "simulator" (demos only).
# PAYMENT_PROVIDER=live
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CURRENCY=RWF
# AIRTEL_BASE_URL=https://openapiuat.airtel.africa
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

# Protects the scheduled job at /api/cron
# CRON_SECRET=

# Public address, used in SMS links
# NEXT_PUBLIC_SITE_URL=https://example.rw

# Local development upload location. Production requires private Vercel Blob storage.
# UPLOAD_DIR=
# BLOB_READ_WRITE_TOKEN=  # local/non-Vercel use; on Vercel connect a private Blob store for OIDC

# Used once by `npm run db:setup` on a new production database
# OWNER_NAME=
# OWNER_PHONE=

# Days after a request finishes before the customer's uploaded documents are deleted (default 90)
# DOC_RETENTION_DAYS=90

# Used only by `npm run check:providers`: who receives the test SMS and mobile money prompts
# TEST_PHONE=788123456
# TEST_AIRTEL_PHONE=732123456
# CHECK_AMOUNT=100
