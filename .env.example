# Current release: real-money processing is deferred. Leave PAYMENT_PROVIDER unset or disabled.
# Provider credentials below document future integration points; do not enable live processing for this release.

# Copy to .env.local. Nothing here is needed for local development.

# Postgres. Without it the app uses the embedded database in .data/pglite.
# DATABASE_URL=postgres://user:password@host:5432/inzira
# Direct (not pooled) address, used only for startup migrations when DATABASE_URL goes through a pooler.
# DATABASE_URL_UNPOOLED=
# Skip the automatic schema update on startup and run `npm run db:migrate` yourself.
# DB_AUTO_MIGRATE=0

# Demo mode for staging builds: shows sign-in codes on screen and simulates payments. Never on the live site.
# INZIRA_DEMO=1

# Keys sign-in codes to this server. Set a long random value on the live site (openssl rand -hex 32).
# AUTH_SECRET=

# Encrypts customers' national ID and TIN numbers in the database. Required on the live site (openssl rand -hex 32).
# Keep a copy outside the server: without it the numbers cannot be read. To rotate, see README (DATA_KEY_PREVIOUS, db:rekey).
# DATA_KEY=
# DATA_KEY_PREVIOUS=

# Behind your own proxy (not Vercel): the header it sets with the caller's address, which rate limits trust.
# CLIENT_IP_HEADER=x-real-ip

# Staff sign in at /staff with a username, a password and an authenticator-app code. On a live site every staff
# account must set up both before working; 0 turns that off, 1 turns it on in development and demos.
# REQUIRE_STAFF_TOTP=1
# New staff passwords are checked against the Have I Been Pwned list (only a 5-character hash prefix is sent). 0 turns it off.
# PASSWORD_BREACH_CHECK=0

# Optional bot check on the code forms (Cloudflare Turnstile). Both keys, or it stays off.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Email (sign-in codes for customers, and updates about their requests). Test it with `npm run check:email`.
# Resend (resend.com) sends first. Verify the sending domain in Resend, then use a "Sending access" key for it.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Inzira <no-reply@inziraservices.com>"
# Optional: stop using Resend after this many messages in 24 hours.
# RESEND_DAILY_LIMIT=
# SMTP (your mailbox) is the backup: it sends whenever Resend can't (quota used up, Resend down).
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465
# SMTP_USER=no-reply@your-domain
# SMTP_PASS=
# The mailbox's own address as sender (most mailboxes refuse any other). Defaults to EMAIL_FROM.
# SMTP_FROM="Inzira <no-reply@your-domain>"
# Stay a little under the mailbox's own daily limit (default 400).
# SMTP_DAILY_LIMIT=400
# EMAIL_REPLY_TO=contact@inziraservices.com
# Force one provider: smtp (Resend off) or resend (no backup). Unset: Resend, then SMTP.
# EMAIL_PROVIDER=
# Set to 0 once customers have added their email, to end phone sign-in for customers (staff keep it).
# CUSTOMER_PHONE_SIGNIN=0

# SMS (staff sign-in codes, and updates to customers who have no email yet)
# SMS_PROVIDER=africastalking
# AT_USERNAME=
# AT_API_KEY=
# AT_SENDER_ID=

# Mobile money. "live" uses IntouchPay (MTN and Airtel). "simulator" approves prompts locally.
# "direct" keeps the older MTN MoMo and Airtel Money APIs.
# PAYMENT_PROVIDER=live
# Issued by IntouchPay. Test credentials and production credentials use the same request shape.
# INTOUCHPAY_USERNAME=
# INTOUCHPAY_ACCOUNT_NO=
# INTOUCHPAY_PARTNER_PASSWORD=
# Leave unset for live payments (the default is the live API). The sandbox is https://developer.intouchpay.co.rw/api/v1/sandbox
# with an SBX account number; Admin › System marks it as test money.
# INTOUCHPAY_BASE_URL=https://www.intouchpay.co.rw/api
# The live API only answers whitelisted addresses and Vercel has none fixed. A static-IP proxy (QuotaGuard Static, Fixie)
# gives one: set its URL here and send its IP addresses to IntouchPay. Only IntouchPay calls use it.
# INTOUCHPAY_PROXY_URL=http://user:password@proxy-host:port
# Optional HTTP Basic on the callback (API guide section 2.7). Every callback is acknowledged with 200 whether or not it
# has this login, and only makes us re-check the payment. A callback that does send it may also close a declined prompt at once.
# INTOUCHPAY_CALLBACK_USER=
# INTOUCHPAY_CALLBACK_PASSWORD=
# Direct MTN/Airtel, only when PAYMENT_PROVIDER=direct
# MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# MTN_MOMO_ENVIRONMENT=sandbox
# MTN_MOMO_SUBSCRIPTION_KEY=
# MTN_MOMO_API_USER=
# MTN_MOMO_API_KEY=
# MTN_MOMO_CURRENCY=RWF
# AIRTEL_BASE_URL=https://openapiuat.airtel.africa
# AIRTEL_CLIENT_ID=
# AIRTEL_CLIENT_SECRET=

# Protects the scheduled job at /api/cron
# CRON_SECRET=

# Official production address, confirmed by the business owner; used in canonical URLs and SMS links
# The live site address. Once set, production answers 404 on its *.vercel.app address.
NEXT_PUBLIC_SITE_URL=https://inziraservices.com

# Local development upload location. Production requires private Vercel Blob storage.
# UPLOAD_DIR=
# BLOB_READ_WRITE_TOKEN=  # local/non-Vercel use; on Vercel connect a private Blob store for OIDC

# Used once by `npm run db:setup` on a new production database
# OWNER_NAME=
# OWNER_PHONE=

# Owner's console login, set once at start-up (see README). Hash: OWNER_PASSWORD='…' npm run db:owner -- hash
# OWNER_USERNAME=
# OWNER_PASSWORD_HASH=

# Days after a request finishes before the customer's uploaded documents are deleted (default 90)
# DOC_RETENTION_DAYS=90

# Used only by `npm run check:providers`: who receives the test SMS and mobile money prompts
# TEST_PHONE=788123456
# TEST_AIRTEL_PHONE=732123456
# CHECK_AMOUNT=100

# What a quoted request costs to send (RWF). It is taken off our fee when the quote is paid. 0 sends quoted requests free.
# Read when the site is built: redeploy after changing it.
# NEXT_PUBLIC_REVIEW_FEE_RWF=1000

# The name a customer's phone shows on the MTN MoMo / Airtel Money prompt (ask IntouchPay). When set, the payment screen
# says it, so the prompt is trusted. Read when the site is built.
# NEXT_PUBLIC_MOMO_MERCHANT_NAME=

# Google Search Console URL-prefix property verification (the public meta-tag content value only).
# This does not submit the sitemap or grant API access. DNS verification can be used instead.
# GOOGLE_SITE_VERIFICATION=

# For a non-Vercel staging deployment: block indexing without enabling sample/demo behavior.
# SEO_NOINDEX=1
